# Copy to deploy/buzz/.env, chmod 600, then replace every CHANGE_ME.
# Paths must be absolute; checkout is external to Mailflare.
BUZZ_SOURCE_DIR=/Users/CHANGE_ME/buzz
BUZZ_DATA_DIR=/Users/CHANGE_ME/buzz-data
DATABASE_URL=postgres://buzz:CHANGE_ME@127.0.0.1:5432/buzz
# Reuse Homebrew Redis by default; choose an unused logical DB (1 here).
BUZZ_REDIS_MODE=existing
REDIS_URL=redis://127.0.0.1:6379/1
# For isolated PM2 Redis: BUZZ_REDIS_MODE=managed, REDIS_URL=redis://127.0.0.1:6380/0
BUZZ_BIND_ADDR=127.0.0.1:3200
BUZZ_HEALTH_PORT=8083
# Before public use set wss://buzz.your-domain.com (the dedicated tunnel hostname).
RELAY_URL=ws://127.0.0.1:3200
# Generate relay secret and git HMAC separately with openssl rand -hex 32.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX
# Public hex key from your own Buzz/Nostr identity, NOT its private key.
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_PUBLIC_KEY
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_S3_ENDPOINT=http://127.0.0.1:9000
BUZZ_S3_ACCESS_KEY=CHANGE_ME
BUZZ_S3_SECRET_KEY=CHANGE_ME
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_REGION=us-east-1
BUZZ_S3_ADDRESSING_STYLE=path
BUZZ_DB_POOL_SIZE=5
BUZZ_REDIS_POOL_SIZE=4
RUST_LOG=buzz_relay=info,buzz_db=warn,buzz_pubsub=warn
# Optional: /opt/homebrew/bin/redis-server by default.
# BUZZ_REDIS_BINARY=/opt/homebrew/bin/redis-server
