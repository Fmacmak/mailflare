# Copy to .env.selfhosted. Never commit the real file.
NODE_ENV=production
MAILFLARE_RUNTIME=node
HOST=127.0.0.1
PORT=3100
DATA_DIR=./data/mailflare
# sqlite (default) or postgres. Use a dedicated DB/user on your Umami PG server.
DATABASE_BACKEND=sqlite
DATABASE_URL=
# Small pool for the 8 GB laptop; one PM2 Mailflare instance.
DATABASE_POOL_SIZE=4
# Set your stable public HTTPS hostname before configuring receiving.
APP_URL=
SMTP_INBOUND_PORT=0
RESEND_API_KEY=
# Optional Cloudflare zone-management token, separate from tunnel credentials.
CF_TOKEN=
# Only needed when receiving through the Cloudflare email relay.
INBOUND_WEBHOOK_SECRET=

STORAGE_BACKEND=minio
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=mailflare
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Use the same credentials as S3 above for the initial private single-bucket server.
# You can replace S3 credentials with a dedicated bucket-scoped user afterwards.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DATA_DIR=./data/minio
# Defaults to ~/.local/bin/minio. Set an absolute path if installed elsewhere.
MINIO_BINARY=

# One-time bootstrap: set these, run setup:selfhosted, then clear the password.
MAILFLARE_ADMIN_EMAIL=
MAILFLARE_ADMIN_PASSWORD=
# Optional; name and logo remain editable under Admin > Branding.
MAILFLARE_BRAND_NAME=
# receiving: resend or cloudflare (Cloudflare requires the relay Worker)
MAILFLARE_RECEIVING_PROVIDER=resend

# Optional personal WhatsApp linking; uses private sessions in DATA_DIR/whatsapp.
WHATSAPP_ENABLED=false
WHATSAPP_MAX_SESSIONS=4
